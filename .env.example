# Database (AWS RDS PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@your-rds-endpoint:5432/blackkeyx

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=blackkeyx-documents

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# OpenAI model selection per task (tiered by complexity/cost)
# Flagship for deal-memo extraction (financial accuracy matters)
OPENAI_MODEL_DEAL_EXTRACTION=gpt-5.4
# Mid-tier for conversational chatbot
OPENAI_MODEL_CHATBOT=gpt-5.4-mini
# Mid-tier for transcript insight extraction
OPENAI_MODEL_INSIGHTS=gpt-5.4-mini
# Cheapest for trivial title/description extraction
OPENAI_MODEL_METADATA=gpt-4o-mini
# Embedding model for semantic search
OPENAI_MODEL_EMBEDDING=text-embedding-3-small

# Admin Authentication (simple password + cookie)
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_API_KEY=your-secure-api-key

# Agent Callback Secret (shared with voice agent — must match AGENT_CALLBACK_SECRET in agent .env)
AGENT_CALLBACK_SECRET=your-secure-agent-secret

# Rate Limiting (slowapi format: "N/minute", "N/hour", etc.)
RATE_LIMIT_LEAD=5/minute
RATE_LIMIT_ADMIN_AUTH=5/minute
RATE_LIMIT_GLOBAL=100/minute

# Application
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]
